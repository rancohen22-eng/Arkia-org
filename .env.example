# העתק ל-.env (לא נכנס ל-git). ערכים לדוגמה:
SECRET_KEY=change-me-to-a-long-random-hex
SESSION_HTTPS_ONLY=0
SESSION_IDLE_SECONDS=3600
# משתמשי המערכת (מסך האדמין). לחלופין קובץ users.txt בשורש בפורמט user:pass
ARKIA_USERS=ranc:change-me
ADMIN_USERS=ranc

# ── מודול החזרי הוצאות ─────────────────────────────────────────────
# כל הערכים אופציונליים: בלי הגדרה המערכת עדיין רצה — OCR עובר להזנה ידנית,
# ומיילים נשמרים ל-data/outbox/ במקום להישלח.

# כתובת בסיס ציבורית — לבניית לינקי אישור בתוך המיילים
# APP_BASE_URL=https://expenses.arkia.co.il

# ── מייל: רלֵיי OCI Email Delivery של אורקל (STARTTLS) ──────────────
# כתובת ה-From חייבת להיות Approved Sender ב-OCI; שם המשתמש/סיסמה הם של
# OCI Email Delivery — לא סיסמת Gmail. הקרדנציאלס נשמרים כאן בלבד, לא בקוד.
# SMTP_HOST=smtp.email.il-jerusalem-1.oci.oraclecloud.com
# SMTP_PORT=587
# SMTP_STARTTLS=1
# SMTP_USERNAME=ocid1.user.oc1..xxxx@ocid1.tenancy.oc1..xxxx.xx.com
# SMTP_PASSWORD=your-oci-smtp-password
# SMTP_FROM=arkiapnr@gmail.com
# SMTP_FROM_NAME=ארקיע · החזרי הוצאות

# ── OCR: Google Cloud Vision (קורא ספק + סכום מצילום החשבונית) ──────
# OCR_ENGINE=google
# GOOGLE_VISION_API_KEY=your-google-cloud-vision-api-key

# ── Passkeys / WebAuthn (אופציונלי; דורש pip install webauthn) ──────
# WEBAUTHN_RP_ID=expenses.arkia.co.il
# WEBAUTHN_ORIGIN=https://expenses.arkia.co.il
# WEBAUTHN_RP_NAME=ארקיע
